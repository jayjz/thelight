# Server-only Alpaca PAPER credentials. Never prefix these with VITE_.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_SYMBOL=SPY

# PAPER_REPLAY is the default. ALPACA_PAPER never falls back to synthetic data.
LIGHTLIGHT_MODE=PAPER_REPLAY

# Required before the durable Alpaca PAPER worker can receive dispatch authority.
DATABASE_URL=
