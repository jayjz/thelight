# Environment contract
#
# WEB / VERCEL
# DATABASE_URL is optional for the UI build and replay-only pages. Set it when
# deployed server functions need Neon-backed read access. It remains server-only.
DATABASE_URL=

# The Vercel web application defaults to replay mode; if set there, this must
# remain PAPER_REPLAY. It must not receive any ALPACA_* value. Do not prefix
# DATABASE_URL or any secret with VITE_.
LIGHTLIGHT_MODE=PAPER_REPLAY

# WORKER HOST ONLY (never configure these on Vercel)
# The long-lived, operator-started PAPER worker requires all of these together
# with DATABASE_URL. PAPER-only domains and SPY remain enforced in code.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_SYMBOL=SPY
